    <div class="container">
      <h1 style="font-family: var(--font-serif); font-size: clamp(48px, 8vw, 96px); margin-bottom: 16px;">404</h1>
      <p style="font-size: 18px; color: var(--text-muted); margin-bottom: 32px;">This page drifted off the radar.</p>
      <a href="/" class="btn-primary">← Back to base</a>
    </div>
  </section>
</Layout>
