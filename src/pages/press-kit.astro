---
import Layout from '../layouts/Layout.astro';

const title = 'Press Kit — The UFO Wizard';
const description = 'Press kit for Josh Rutledge, MUFON Field Investigator and Chief Investigator for Arizona. Download bio, headshot, and background information for media use.';
---

<Layout title={title} description={description}>
  <section style="padding-top: 120px;">
    <div class="container">
      <div class="section-label">Press Kit</div>
      <h2 class="section-title">Media Resources</h2>
      <p class="section-sub">Josh Rutledge — MUFON Field Investigator, Chief Investigator for Arizona, and developer of investigator tools for UAP analysis. Available for interviews, podcasts, and commentary.</p>
    </div>
  </section>

  <section style="padding-top: 20px;">
    <div class="container">
      <div class="press-bio">
        <h3>Bio</h3>
        <p>Josh Rutledge is a MUFON Field Investigator and Chief Investigator for Arizona, specializing in evidence-based UAP investigation. He combines witness testimony, sensor data, and systematic elimination protocols to separate the explained from the unexplained — no speculation, only documented findings.</p>
        <p>He developed a suite of free investigator tools — including the Satellite Flare Checker, Sat or UFO, Evidence Lab, and UFO Disclosure Timeline — used by field investigators to eliminate common explanations quickly and focus on what's genuinely unexplained. The tools use live TLE satellite data from CelesTrak and are built to work in the field on a phone.</p>
        <p>Based in Arizona, Josh investigates sightings across the Southwest. He holds an M.S. in Psychology (Research) and applies the same rigor to UAP cases: assign confidence levels, separate observation from interpretation, cite verifiable sources, and protect witness identity.</p>
      </div>

      <div class="press-grid">
        <div class="press-card">
          <h3>Headshot</h3>
          <p>High-resolution headshot for media use. Right-click and save, or contact for specific formats.</p>
          <a href="/images/josh-rutledge-headshot.jpg" class="download-link" download>⬇ Download headshot</a>
        </div>
        <div class="press-card">
          <h3>Logos & Assets</h3>
          <p>The UFO Wizard logo and brand assets for event programs and promotional materials.</p>
          <a href="/images/ufo-wizard-logo.png" class="download-link" download>⬇ Download logo</a>
        </div>
        <div class="press-card">
          <h3>Topics</h3>
          <p>Evidence-based UAP investigation methodology, satellite identification techniques, the history of government disclosure, and building open-source tools for field investigators.</p>
        </div>
        <div class="press-card">
          <h3>Availability</h3>
          <p>Available for podcast appearances, conference talks, panel discussions, and media interviews — remote or in-person in the Phoenix/Arizona area.</p>
          <a href="/contact" class="download-link">Contact to book →</a>
        </div>
      </div>
    </div>
  </section>

  <section style="padding-top: 20px;">
    <div class="container">
      <div class="section-label">Credentials</div>
      <h2 class="section-title">Background</h2>
      <div class="credentials" style="margin-top: 24px;">
        <span class="credential"><span class="check">✓</span> MUFON Field Investigator</span>
        <span class="credential"><span class="check">✓</span> MUFON Chief Investigator, Arizona</span>
        <span class="credential"><span class="check">✓</span> M.S. Psychology (Research)</span>
        <span class="credential"><span class="check">✓</span> Tool Developer</span>
        <span class="credential"><span class="check">✓</span> Based in Arizona</span>
      </div>
      <div style="margin-top: 32px;">
        <a href="/contact" class="btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>
</Layout>
